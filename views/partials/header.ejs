<header class="<%= (locals.esHome) ? 'header-principal' : 'header-principal-1' %>">

  <% if (locals.esHome) { %>
  <video autoplay muted loop id="video-fondo">
    <source src="/videos/video-header-luz-de-lila.mp4" type="video/mp4">
  </video>
  <% } %>

  <div class="barra-superior">

    <a href="/">
      <img src="/img/logo/LUZDLILA.png" alt="Logo Luz de Lila">
    </a>

    <div class="barra-busqueda">
      <input type="text" name="query" placeholder="Buscar productos...">
      <button type="submit">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>

      </button>
    </div>
    <button id ="cart-btn">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="carrito-icon">
        <path d="M6 2h1.84a1 1 0 0 1 .97.76l1.38 5.52M4 7h17.5a1 1 0 0 1 .95 1.32l-2.1 6.3A2 2 0 0 1 18.44 16H8.56a2 2 0 0 1-1.95-1.57L4 4H2" />

        <circle cx="9" cy="20" r="1.5" fill="currentColor" />

        <circle cx="18" cy="20" r="1.5" fill="currentColor" />
      </svg>
    </button>

    <%- include('menu') %>

</header>