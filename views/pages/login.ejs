<%- include('../partials/head.ejs') %>

<body>

  <%- include('../partials/menu.ejs') %>

  <header class="header-principal header-principal-login">
    <video autoplay muted loop id="video-fondo">
      <source src="/videos/video-header-luz-de-lila.mp4" type="video/mp4">
    </video>

    <main class="login-main">
      <section class="login-section">
        
        <div id="card-login" class="login-container glassmorphism">
          <div class="login-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="profile-icon">
              <path d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <h2>Ingreso</h2>
          </div>

          <form action="/login" method="POST">
            <div class="input-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="input-icon"><path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
              <input type="email" name="email" placeholder="Email" required>
            </div>

            <div class="input-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="input-icon"><path d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
              <input type="password" name="password" placeholder="Password" required>
            </div>

            <div class="options-group">
              <label class="remember-me">
                <input type="checkbox" name="remember"> Recordarme
              </label>
              <a href="#" id="go-to-recovery" class="forgot-password">Olvidé mi contraseña</a>
            </div>

            <button type="submit" class="login-button">LOGIN</button>
          </form>

          <div class="login-footer">
            <p>¿No tenés cuenta? <a href="#" id="go-to-register">Registrarse</a></p>
          </div>
        </div>

        <div id="card-register" class="login-container glassmorphism hidden">
          <div class="login-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="profile-icon">
              <path d="M19 7.5l-9.385 9.385L5 12.308M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z" />
            </svg>
            <h2>Registro</h2>
          </div>

          <form action="/register" method="POST">
            <div class="input-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="input-icon"><path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
              <input type="text" name="name" placeholder="Nombre Completo" required>
            </div>

            <div class="input-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="input-icon"><path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
              <input type="email" name="email" placeholder="Email" required>
            </div>

            <div class="input-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="input-icon"><path d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
              <input type="password" name="password" placeholder="Password" required>
            </div>

            <button type="submit" class="login-button">REGISTRARME</button>
          </form>

          <div class="login-footer">
            <p>¿Ya tenés cuenta? <a href="#" class="go-to-login-btn">Ingresar</a></p>
          </div>
        </div>

        <div id="card-recovery" class="login-container glassmorphism hidden">
          <div class="login-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="profile-icon">
              <path d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H3.75v-1.5l6.113-6.113a1.5 1.5 0 00.43-1.563 6 6 0 119.507-5.524z" />
            </svg>
            <h2>Recuperar</h2>
            <p style="color: #cccccc; margin-top: 10px; font-size: 0.9rem; letter-spacing: 1px;">Ingresá tu correo electrónico para restablecer tu contraseña.</p>
          </div>

          <form action="/recover-password" method="POST">
            <div class="input-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="input-icon"><path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
              <input type="email" name="email" placeholder="Email de recuperación" required>
            </div>

            <button type="submit" class="login-button">ENVIAR ENLACE</button>
          </form>

          <div class="login-footer">
            <p><a href="#" class="go-to-login-btn">Volver al Ingreso</a></p>
          </div>
        </div>

      </section>
    </main>
  </header>
  
<script src="/js/login.js"></script>

  <script type="module" src="/js/main.js"></script>
 
</body>
</html>