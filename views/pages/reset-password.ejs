<%- include('../partials/head.ejs') %>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="index-main botanical-bg" style="display: flex; justify-content: center; align-items: center; min-height: 100vh;">
        
        <div class="glassmorphism" style="padding: 40px; width: 100%; max-width: 400px; text-align: center;">
            <h2 style="color: #FF00FF; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 20px;">
                Recuperar Contraseña
            </h2>
            
            <form action="/reset-password" method="POST" style="display: flex; flex-direction: column; gap: 20px;">
                <input 
                    type="password" 
                    name="password" 
                    placeholder="Escribí tu nueva contraseña"
                    style="background: rgba(0,0,0,0.5); border: 1px solid rgb(198, 141, 251); color: white; padding: 15px; outline: none;"
                >
                
                <button type="submit" class="btn-finalizar-neon">
                    ACTUALIZAR CLAVE
                </button>
            </form>
        </div>

    </main>

    <script type="module" src="/js/main.js"></script>
</body>
</html>