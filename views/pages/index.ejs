<%- include('../partials/head.ejs') %>

<body>

  <%- include('../partials/header') %>
  <%- include('../partials/menu') %>

  <main class="main-content">
    <section class="destacados-container">

      <div class="products-grid">
        <% if (typeof listaVelas !== 'undefined' && listaVelas.length > 0) { %>

          <% listaVelas.forEach(vela => { %>
            <article class="product-card glassmorphism" data-categoria="<%= vela.categoria %>">
              
              <div class="product-image-container">
                <img src="<%= vela.imagen[0] %>" alt="<%= vela.nombre %>" class="product-img">
              </div>

              <div class="product-info" style="text-align: center; margin: 15px 0;">
                <h3 style="color: white; font-size: 1.1rem; margin-bottom: 5px;"><%= vela.nombre %></h3>
                <p style="color: #FF00FF; font-weight: bold; font-size: 1.2rem;">$<%= vela.precio %></p>
              </div>

              <button class="btn-agregar btn-agregar-neon" data-id="<%= vela.id %>" data-nombre="<%= vela.nombre %>" data-precio="<%= vela.precio %>">
                Añadir al Carrito
              </button>

            </article>
          <% }) %>

        <% } else { %>
          <p class="no-products" style="color: #000000; text-align: center; width: 100%;">
            No se encontraron productos disponibles.
          </p>
        <% } %>
      </div>
    </section>
  </main>

  <div id="carrito-panel" class="carrito-sidebar glassmorphism">
    <div class="cart-header">
        <h2>Tu Carrito</h2>
        <button id="cerrar-carrito">X</button>
    </div>
    
    <div class="cart-items" id="lista-carrito">
    </div>
    
    <div class="cart-footer">
        <div class="cart-total-summary">
            <span>Total:</span>
            <span id="total-carrito">$0</span>
        </div>
        <button class="btn-finalizar-neon">FINALIZAR COMPRA</button>
    </div>
  </div>
  
  <script type="module" src="/js/main.js"></script>

</body>