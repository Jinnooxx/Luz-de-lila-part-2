<%- include('../partials/head.ejs') %>

<body>

  <%- include('../partials/header') %>
  <%- include('../partials/menu') %>

  <main class="main-content">
    <h2></h2>
    <section class="destacados-container">

      <div class="products-grid">
        <% if (typeof listaVelas !== 'undefined' && listaVelas.length > 0) { %>

          <% listaVelas.forEach(vela => { %>
            <article class="product-card glassmorphism" data-categoria="<%= vela.categoria %>">
              
              <div class="product-image-container">
                <img src="<%= vela.imagen[0] %>" alt="<%= vela.nombre %>" class="product-img">
              </div>

              <div class="product-info">
                <h3 ><%= vela.nombre %></h3>
                <p>$<%= vela.precio %></p>
              </div>

             </article>
          <% }) %>

        <% } else { %>
          <p>
            No se encontraron productos disponibles.
          </p>
        <% } %>
      </div>
    </section>
  </main>


  <script type="module" src="/js/main.js"></script>

</body>